  id: npc.cartographer
  displayName: "Ng\u01B0\u1EDDi V\u1EBD H\u1EA3i \u0110\u1ED3"
  dialogueLines:
  - "Tuy\u1EBFn n\xE0y v\u1EEBa m\u1EDF. Ta \u0111ang v\u1EBD l\u1EA1i h\u1EA3i \u0111\u1ED3
