  m_Script: {fileID: 11500000, guid: 3f4219f40d50cb44f8c4ef96bafe2c06, type: 3}
  m_Name: NPC_TownGuide
  m_EditorClassIdentifier: Game.Core::Game.Core.NPC.NPCDefinition
  id: npc.town_guide
  displayName: "Ng\u01B0\u1EDDi Ch\u1EC9 \u0110\u01B0\u1EDDng"
  dialogueLines:
  - "B\u1EA3n \u0111\u1ED3 T\u1EA7ng 1 v\u1EABn c\xF2n nhi\u1EC1u kho\u1EA3ng tr\u1EAFng.
    Qu\xE1i c\xE0ng g\u1EA7n Th\xE1p, c\xE0ng m\u1EA1nh \u2014 \u0111\u1EEBng \u0111i
    qu\xE1 xa khi ch\u01B0a \u0111\u1EE7 m\xE1u."
  - "Ng\u1ECDn \u0111\xE8n \u1EDF gi\u1EEFa th\u1ECB tr\u1EA5n l\xE0 v\xF9ng an to\xE0n.
    Qu\xE1i kh\xF4ng d\xE1m b\xE9n m\u1EA3ng t\u1EDBi \u0111\xF3, c\u1EE9 y\xEAn
    t\xE2m ngh\u1EC9 ch\xE2n."
  - "Mu\u1ED1n mua \u0111\u1ED3 t\u1ED1t th\xEC gh\xE9 B\xE1c T\xF4 b\xEAn kia. \xD4ng
    \u1EA5y thu mua c\u1EA3 \u0111\u1ED3 nh\u1EB7t \u0111\u01B0\u1EE3c, nh\u1EDB
    b\xE1n b\u1EDBt cho nh\u1EB9 t\xFAi."
  questOfferLine: "Ng\u01B0\u01A1i c\xF3 mu\u1ED1n gi\xFAp ta kh\xF4ng?"
  questInProgressLine: "Xong vi\u1EC7c r\u1ED3i h\xE3y quay l\u1EA1i."
  questCompletedLine: "T\u1ED1t l\u1EAFm. Ph\u1EA7n th\u01B0\u1EDFng c\u1EE7a ng\u01B0\u01A1i
    \u0111\xE2y."
  offeredQuest: {fileID: 0}
  shop: {fileID: 0}
  onlyAtSpecificTime: 0
  activeTimeOfDay: 5
